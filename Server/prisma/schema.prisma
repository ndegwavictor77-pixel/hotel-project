// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  RECEPTIONIST
  CASHIER
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum PaymentMethod {
  CASH
  MPESA
  CARD
  BANK
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum Position {
  MANAGER
  RECEPTIONIST
  CASHIER
  HOUSEKEEPER
  CHEF
  WAITER
  SECURITY
  MAINTENANCE
}

enum Department {
  FRONT_OFFICE
  HOUSEKEEPING
  FOOD_AND_BEVERAGE
  SECURITY
  MAINTENANCE
  MANAGEMENT
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      UserRole @default(RECEPTIONIST)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]
  employee  Employee?
}

model RoomType {
  id            Int     @id @default(autoincrement())
  name          String  @unique
  description   String?
  pricePerNight Float
  capacity      Int

  rooms Room[]
}

model Room {
  id         Int        @id @default(autoincrement())
  roomNumber String     @unique
  floor      Int
  status     RoomStatus @default(AVAILABLE)

  roomTypeId Int
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])

  reservations Reservation[]
  housekeeping HouseKeeping[]
}

model Guest {
  id          Int     @id @default(autoincrement())
  firstName   String
  lastName    String
  email       String? @unique
  phone       String
  idNumber    String?
  nationality String?
  address     String?

  reservations Reservation[]
}

model Reservation {
  id          Int               @id @default(autoincrement())
  checkIn     DateTime
  checkOut    DateTime
  adults      Int
  children    Int               @default(0)
  totalAmount Float
  status      ReservationStatus @default(PENDING)

  //relation
  guestId Int
  guest   Guest @relation(fields: [guestId], references: [id])

  roomId Int
  room   Room @relation(fields: [roomId], references: [id])

  payments Payment[]
  services GuestService[]

  createdAt DateTime @default(now())
}

model Payment {
  id              Int           @id @default(autoincrement())
  amount          Float
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  transactionCode String?
  paidAt          DateTime?

  reservationId Int
  reservation   Reservation @relation(fields: [reservationId], references: [id])
}

model Service {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  price       Float

  guestServices GuestService[]
}

model GuestService {
  id         Int   @id @default(autoincrement())
  quantity   Int
  totalPrice Float

  reservationId Int
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id])
}

model HouseKeeping {
  id        Int       @id @default(autoincrement())
  status    String
  notes     String?
  cleanedAt DateTime?

  roomId Int
  room   Room @relation(fields: [roomId], references: [id])
}

model Expense {
  id          Int      @id @default(autoincrement())
  title       String
  category    String
  amount      Float
  description String?
  expenseDate DateTime
}

model Inventory {
  id           Int    @id @default(autoincrement())
  itemName     String
  quantity     Int
  unit         String
  reorderLevel Int

  transactions InventoryTransaction[]
}

model InventoryTransaction {
  id        Int      @id @default(autoincrement())
  quantity  Int
  type      String
  reference String?
  createdAt DateTime @default(now())

  inventoryId Int
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  tableName String
  recordId  Int
  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])
}

model Employee {
  id Int @id @default(autoincrement())

  firstName   String
  lastName    String
  phone       String?
  nationalId  String?   @unique
  gender      Gender?
  dateOfBirth DateTime?
  address     String?

  position   Position
  department Department

  salary           Float?
  hireDate         DateTime         @default(now())
  employmentStatus EmploymentStatus @default(ACTIVE)

  // Link to login account
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
